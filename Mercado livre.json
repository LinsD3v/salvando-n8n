    {
      "parameters": {
        "jsCode": "const envio = $('Detalhes de envio').first().json;\nconst compra = $('Detalhes da compra').first().json;\nconst identificacao = $input.first().json;\n\nconst Client = {\n  name: envio.destination.receiver_name,\n  cpf: identificacao.identification.number,\n  address: {\n    CEP: identificacao.address.zip_code,\n    address: identificacao.address.address,\n    city: identificacao.address.city,\n    state: identificacao.address.state\n  }\n};\n\nconst item = compra.order_items[0];\n\nconst Items = {\n  name: item.item.title,\n  SKU: item.item.seller_sku,\n  quantity: item.quantity,\n  unit_price: item.unit_price\n};\n\nconst total = Number(Items.quantity) * Number(Items.unit_price);\n\nconst xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<nfeProc xmlns=\"http://www.portalfiscal.inf.br/nfe\" versao=\"4.00\">\n  <NFe xmlns=\"http://www.portalfiscal.inf.br/nfe\">\n    <infNFe Id=\"NFeMOCK${Date.now()}\" versao=\"4.00\">\n\n      <ide>\n        <cUF>41</cUF>\n        <cNF>12345678</cNF>\n        <natOp>Venda de mercadoria</natOp>\n        <mod>55</mod>\n        <serie>1</serie>\n        <nNF>999999</nNF>\n        <dhEmi>${new Date().toISOString()}</dhEmi>\n        <tpNF>1</tpNF>\n        <idDest>1</idDest>\n        <cMunFG>4106902</cMunFG>\n        <tpImp>1</tpImp>\n        <tpEmis>1</tpEmis>\n        <cDV>0</cDV>\n        <tpAmb>2</tpAmb>\n        <finNFe>1</finNFe>\n        <indFinal>1</indFinal>\n        <indPres>2</indPres>\n        <procEmi>0</procEmi>\n        <verProc>MOCK-N8N-1.0</verProc>\n      </ide>\n\n      <emit>\n        <CNPJ>00000000000000</CNPJ>\n        <xNome>EMPRESA TESTE HOMOLOGACAO</xNome>\n        <enderEmit>\n          <xLgr>Rua Teste</xLgr>\n          <nro>100</nro>\n          <xBairro>Centro</xBairro>\n          <cMun>4106902</cMun>\n          <xMun>Curitiba</xMun>\n          <UF>PR</UF>\n          <CEP>80000000</CEP>\n          <cPais>1058</cPais>\n          <xPais>BRASIL</xPais>\n        </enderEmit>\n        <IE>ISENTO</IE>\n        <CRT>3</CRT>\n      </emit>\n\n      <dest>\n        <CPF>${Client.cpf}</CPF>\n        <xNome>${Client.name}</xNome>\n        <enderDest>\n          <xLgr>${Client.address.address}</xLgr>\n          <nro>SN</nro>\n          <xBairro>NAO INFORMADO</xBairro>\n          <cMun>4106902</cMun>\n          <xMun>${Client.address.city}</xMun>\n          <UF>${Client.address.state}</UF>\n          <CEP>${Client.address.CEP}</CEP>\n          <cPais>1058</cPais>\n          <xPais>BRASIL</xPais>\n        </enderDest>\n        <indIEDest>9</indIEDest>\n      </dest>\n\n      <det nItem=\"1\">\n        <prod>\n          <cProd>${Items.SKU}</cProd>\n          <xProd>${Items.name}</xProd>\n          <NCM>00000000</NCM>\n          <CFOP>5102</CFOP>\n          <uCom>UN</uCom>\n          <qCom>${Number(Items.quantity).toFixed(4)}</qCom>\n          <vUnCom>${Number(Items.unit_price).toFixed(4)}</vUnCom>\n          <vProd>${total.toFixed(2)}</vProd>\n          <uTrib>UN</uTrib>\n          <qTrib>${Number(Items.quantity).toFixed(4)}</qTrib>\n          <vUnTrib>${Number(Items.unit_price).toFixed(4)}</vUnTrib>\n          <indTot>1</indTot>\n        </prod>\n\n        <imposto>\n          <vTotTrib>0.00</vTotTrib>\n          <ICMS>\n            <ICMS00>\n              <orig>0</orig>\n              <CST>00</CST>\n              <modBC>3</modBC>\n              <vBC>${total.toFixed(2)}</vBC>\n              <pICMS>0.00</pICMS>\n              <vICMS>0.00</vICMS>\n            </ICMS00>\n          </ICMS>\n        </imposto>\n      </det>\n\n      <total>\n        <ICMSTot>\n          <vBC>${total.toFixed(2)}</vBC>\n          <vICMS>0.00</vICMS>\n          <vICMSDeson>0.00</vICMSDeson>\n          <vFCP>0.00</vFCP>\n          <vBCST>0.00</vBCST>\n          <vST>0.00</vST>\n          <vFCPST>0.00</vFCPST>\n          <vFCPSTRet>0.00</vFCPSTRet>\n          <vProd>${total.toFixed(2)}</vProd>\n          <vFrete>0.00</vFrete>\n          <vSeg>0.00</vSeg>\n          <vDesc>0.00</vDesc>\n          <vII>0.00</vII>\n          <vIPI>0.00</vIPI>\n          <vIPIDevol>0.00</vIPIDevol>\n          <vPIS>0.00</vPIS>\n          <vCOFINS>0.00</vCOFINS>\n          <vOutro>0.00</vOutro>\n          <vNF>${total.toFixed(2)}</vNF>\n          <vTotTrib>0.00</vTotTrib>\n        </ICMSTot>\n      </total>\n\n      <transp>\n        <modFrete>9</modFrete>\n      </transp>\n\n      <pag>\n        <detPag>\n          <tPag>99</tPag>\n          <vPag>${total.toFixed(2)}</vPag>\n        </detPag>\n      </pag>\n\n    </infNFe>\n  </NFe>\n</nfeProc>`;\n\nreturn [\n  {\n    json: {\n      client: Client,\n      items: Items,\n      total: total,\n      xml: xml\n    }\n  }\n];"
      },
